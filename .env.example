# Campus Customs — environment template
#
# Copy this file to `.env` beside it and fill in your own value:
#
#     cp .env.example .env
#
# `.env` holds a real secret and must never be committed or shared.
# Put `.env` in hw4/ (next to this file). The backend loads the closest .env
# it finds, walking up from backend/.

# Portkey gateway API key. Required for the chat.
PORTKEY_API_KEY=your-portkey-api-key-here

# Model for the shopping assistant. Optional — defaults to gpt-5.6-luna.
OPENAI_MODEL=gpt-5.6-luna
